<UserControl x:Class="BreakdownManager.App.Views.ReportBreakdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock Text="Report Breakdown" Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="Reporting as" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Reporters}"
                      SelectedItem="{Binding SelectedReporter}"
                      DisplayMemberPath="FullName"
                      Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="Machine" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Machines}"
                      SelectedItem="{Binding SelectedMachine}"
                      DisplayMemberPath="Name"
                      Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="Priority" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton Content="Low" GroupName="Priority" Margin="0,0,20,0"
                             IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Low}"/>
                <RadioButton Content="Medium" GroupName="Priority" Margin="0,0,20,0"
                             IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Medium}"/>
                <RadioButton Content="High" GroupName="Priority" Margin="0,0,20,0"
                             IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=High}"/>
                <RadioButton Content="Critical" GroupName="Priority"
                             IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Critical}"/>
            </StackPanel>

            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     Padding="8" Margin="0,0,0,16"/>

            <TextBlock Text="Attach Photo" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,16">
                <Button Content="Browse..." Command="{Binding BrowsePhotoCommand}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding PhotoPath}" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="Gray"/>
            </DockPanel>

            <Button Content="REPORT BREAKDOWN" Command="{Binding ReportBreakdownCommand}"
                    Background="{StaticResource AccentBrush}" FontSize="15"
                    Padding="16,12" HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
