<UserControl x:Class="BreakdownManager.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="650">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                Padding="40" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Breakdown Manager" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center"/>
                <TextBlock Text="Sign in to continue" Foreground="Gray" Margin="0,0,0,24" HorizontalAlignment="Center"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" Margin="0,0,0,16" KeyDown="InputBox_KeyDown"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordInput" Padding="8" Margin="0,0,0,8"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             KeyDown="InputBox_KeyDown"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

                <Button Content="LOG IN" Command="{Binding LogInCommand}"
                        Background="{StaticResource AccentBrush}" FontSize="15"
                        Padding="16,12" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>

                <TextBlock Margin="0,20,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="Demo accounts — jabu.n / jabu (supervisor), john.m / john (technician), nkuthalo.mgr / nkuthalo (manager)"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
